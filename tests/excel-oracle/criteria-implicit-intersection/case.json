{
  "schema": "formualizer.excel-oracle.case/v1",
  "id": "criteria-implicit-intersection",
  "description": "Apply Excel implicit intersection when criteria-family scalar arguments receive ranges.",
  "documentation": [
    {
      "title": "Implicit intersection operator: @",
      "url": "https://support.microsoft.com/en-us/excel/implicit-intersection-operator"
    },
    {
      "title": "Range.Formula vs Range.Formula2",
      "url": "https://learn.microsoft.com/en-us/office/vba/excel/concepts/cells-and-ranges/range-formula-vs-formula2"
    },
    {
      "title": "SUMIF function",
      "url": "https://support.microsoft.com/en-us/excel/sumif-function"
    }
  ],
  "workbook": {
    "file": "fixture.xlsx",
    "date_system": "1900",
    "calculation": {
      "iterate": false,
      "max_iterations": 100,
      "max_change": 0.001
    },
    "sheets": [
      {
        "name": "Data",
        "cells": [
          { "address": "E1", "kind": "text", "value": "A" },
          { "address": "E2", "kind": "text", "value": "B" },
          { "address": "E3", "kind": "text", "value": "C" },
          { "address": "P1", "kind": "number", "value": 10 },
          { "address": "P2", "kind": "number", "value": 20 },
          { "address": "P3", "kind": "number", "value": 30 }
        ]
      },
      {
        "name": "Cases",
        "cells": [
          { "address": "B1", "kind": "number", "value": 2 },
          { "address": "H1", "kind": "text", "value": "A" },
          { "address": "H2", "kind": "text", "value": "B" },
          { "address": "H3", "kind": "text", "value": "C" },
          { "address": "J1", "kind": "formula_iie", "value": "=AVERAGEIF(Data!$E$1:$E$3,$H:$H,Data!$P$1:$P$3)" },
          { "address": "J2", "kind": "formula_iie", "value": "=SUMIF(Data!$E$1:$E$3,$H:$H,Data!$P$1:$P$3)" },
          { "address": "J3", "kind": "formula_iie", "value": "=COUNTIF(Data!$E$1:$E$3,$H:$H)" },
          { "address": "A10", "kind": "number", "value": 1 },
          { "address": "B10", "kind": "number", "value": 2 },
          { "address": "C10", "kind": "number", "value": 3 },
          { "address": "A12", "kind": "number", "value": 10 },
          { "address": "B12", "kind": "number", "value": 20 },
          { "address": "C12", "kind": "number", "value": 30 },
          { "address": "B15", "kind": "formula_iie", "value": "=SUMIF(A10:C10,1:1,A12:C12)" }
        ]
      }
    ]
  },
  "targets": ["Cases!J1", "Cases!J2", "Cases!J3", "Cases!B15"],
  "comparison": {
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-9
  }
}
